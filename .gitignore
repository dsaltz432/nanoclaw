# Dependencies
node_modules/
.npm-cache/
# Build output
dist/

# Local data & auth
store/
data/
logs/

# Runtime lock file written by the agent harness
.claude/scheduled_tasks.lock

# Groups - only track base structure and specific CLAUDE.md files
groups/*
!groups/README.md
!groups/main/
!groups/global/
groups/main/*
groups/global/*
!groups/main/CLAUDE.md
!groups/global/CLAUDE.md

# Secrets
*.keys.json
.env

# Spotify cleanup job (.env already covered above). The venv lives outside the repo
# (~/.local/share/nanoclaw/) because launchd/TCC can't exec binaries under ~/Documents.
scripts/spotify-cleanup/.cache

# Temp files
.tmp-*

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/

agents-sdk-docs
